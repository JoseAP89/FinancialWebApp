@page "/account"
@inherits AccountBase
@using AccountModel = FinancialApp.Data.Models.Account
@using FinancialApp.Data.Models
@using FinancialApp.Components.Accounts
@using MudBlazor

<PageTitle>Accounts</PageTitle>

<div class="account-page">
    <div class="account-header">
        <div>
            <MudText Typo="Typo.h4">Accounts</MudText>
            <MudText Typo="Typo.body2" Class="account-subtitle">Manage and review the accounts in your database.</MudText>
        </div>
        <div class="account-create">
            <MudText Typo="Typo.body1">Create account</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Add"
                           Color="Color.Primary"
                           aria-label="Create account"
                           OnClick="OpenCreateAccountDialogAsync" />
        </div>
    </div>

    @if (IsLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="account-loading" />
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="account-message">@ErrorMessage</MudAlert>
    }
    else
    {
        <div class="account-filters">
            <MudSelect T="AccountFilterMode"
                       Value="FilterMode"
                       ValueChanged="OnFilterModeChanged"
                       Label="Filter"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="account-filter-control">
                <MudSelectItem Value="AccountFilterMode.None">None</MudSelectItem>
                <MudSelectItem Value="AccountFilterMode.FinancialStatement">Financial statement</MudSelectItem>
                <MudSelectItem Value="AccountFilterMode.NumberOfLines">Number of lines</MudSelectItem>
            </MudSelect>

            @if (FilterMode == AccountFilterMode.FinancialStatement)
            {
                <MudSelect T="FinancialStatement?"
                           Value="FilterFinancialStatement"
                           ValueChanged="OnFilterFinancialStatementChanged"
                           Label="Financial statement"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           Class="account-filter-control">
                    @foreach (var statement in Enum.GetValues<FinancialStatement>())
                    {
                        <MudSelectItem T="FinancialStatement?" Value="@((FinancialStatement?)statement)">@statement</MudSelectItem>
                    }
                </MudSelect>
            }
            else if (FilterMode == AccountFilterMode.NumberOfLines)
            {
                <MudSelect T="LineCountComparison"
                           Value="FilterLineCountComparison"
                           ValueChanged="OnLineCountComparisonChanged"
                           Label="Condition"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="account-filter-control">
                    <MudSelectItem Value="LineCountComparison.GreaterThan">Greater than</MudSelectItem>
                    <MudSelectItem Value="LineCountComparison.EqualTo">Equal to</MudSelectItem>
                    <MudSelectItem Value="LineCountComparison.LessThan">Less than</MudSelectItem>
                </MudSelect>

                <MudNumericField T="int?"
                                 Value="FilterLineCount"
                                 ValueChanged="OnLineCountChanged"
                                 Label="Number of lines"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="0"
                                 Class="account-filter-control"
                                 aria-label="Number of lines" />
            }
        </div>

        <MudTable T="AccountModel"
                  Items="FilteredAccounts"
                  Dense="true"
                  Hover="true"
                  Striped="true"
                  Breakpoint="Breakpoint.Sm"
                  Class="account-table">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Account list</MudText>
                <MudSpacer />
                <MudTextField T="string"
                              Value="SearchString"
                              ValueChanged="OnSearchChanged"
                              Placeholder="Search accounts"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Immediate="true"
                              Clearable="true"
                              Class="account-search" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Description</MudTh>
                <MudTh>Financial Statement</MudTh>
                <MudTh>Parent ID</MudTh>
                <MudTh># of lines</MudTh>
                <MudTh>Created at</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="ID">@context.Id</MudTd>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Description">@context.Description</MudTd>
                <MudTd DataLabel="Financial Statement">@context.FinancialStatement</MudTd>
                <MudTd DataLabel="Parent ID">@(context.ParentId?.ToString() ?? "—")</MudTd>
                <MudTd DataLabel="# of lines">@GetTransactionLineCount(context.Id)</MudTd>
                <MudTd DataLabel="Created at">@context.CreatedAt.ToLocalTime().ToString("MMM d, yyyy HH:mm")</MudTd>
                <MudTd DataLabel="Actions">
                    <div class="account-actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       Disabled="@context.IsSystem"
                                       OnClick="@(() => OpenEditAccountDialogAsync(context))"
                                       aria-label="Edit account" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       Disabled="@context.IsSystem"
                                       OnClick="@(() => OpenDeleteAccountDialogAsync(context))"
                                       aria-label="Delete account" />
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="account-empty">No matching accounts found.</MudText>
            </NoRecordsContent>
        </MudTable>
    }
</div>
